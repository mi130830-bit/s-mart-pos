#pragma once

// Wi-Fi is used only when USE_4G is disabled in GPS.ino.
constexpr const char* WIFI_SSID = "YOUR_WIFI_SSID";
constexpr const char* WIFI_PASSWORD = "YOUR_WIFI_PASSWORD";

// Finn Mobile / DTAC commonly uses "internet"; confirm with the SIM provider.
constexpr const char* GPS_APN = "internet";

// Must match the GPS device key configured on the backend server.
constexpr const char* GPS_DEVICE_KEY = "PASTE_GPS_DEVICE_KEY_HERE";
